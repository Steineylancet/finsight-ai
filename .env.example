# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Two-model strategy: mini routes and picks tools, full writes every answer
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_FULL_DEPLOYMENT=gpt-4o

# Optional: LangSmith tracing (free tier at smith.langchain.com). LangChain picks
# these up automatically — every graph node, tool call and LLM call is traced.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<your-langsmith-key>
# LANGSMITH_PROJECT=finsight

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=finsight-index

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=<your-blob-storage-connection-string>
AZURE_STORAGE_CONTAINER_NAME=financial-data
